# Database Configuration
# Runtime app connection. Use pooled URL if provider requires it.
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"

# Direct DB connection for Prisma CLI migrations/generate.
DIRECT_URL="postgresql://username:password@host:port/database"

# Supabase Auth Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Keep secret!

# Vercel Blob CDN Upload Token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_key"

# Google reCAPTCHA v3 Keys
VITE_RECAPTCHA_SITE_KEY="client-side-site-key"
RECAPTCHA_SECRET_KEY="server-side-secret-key"

# Resend Email Integration
RESEND_API_KEY="re_yourkey"
RESEND_SENDER_EMAIL="Tokolink <noreply@yourdomain.com>"
