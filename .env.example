# Database Configuration
# Runtime app connection. Use pooled URL if provider requires it.
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"

# Direct DB connection for Prisma CLI migrations/generate.
DIRECT_URL="postgresql://username:password@host:port/database"

# Supabase Auth Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key" # Keep secret!
# Local access-token verification uses the project's public JWKS
# (SUPABASE_URL/.well-known/jwks.json, asymmetric ES256/RS256 signing keys) --
# no extra secret needed, no GoTrue network round-trip per request.
# Required in production; falls back to supabaseAdmin.auth.getUser only in development.
OTP_HASH_SECRET="replace-with-long-random-otp-hmac-secret" # Keep secret!

# Legacy Vercel Blob URLs stay readable during media migration.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_key"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key-id"
R2_SECRET_ACCESS_KEY="r2-secret-access-key"
R2_BUCKET="tokolink-media"
R2_PUBLIC_BASE_URL="https://media.yourdomain.com"

# Cloudflare Turnstile Keys
VITE_TURNSTILE_SITE_KEY="client-side-site-key"
TURNSTILE_SECRET_KEY="server-side-secret-key"
# Optional comma-separated host allowlist for Turnstile responses.
TURNSTILE_ALLOWED_HOSTNAMES="localhost"

# Pakasir Payment
PAKASIR_PROJECT_SLUG="tokolink-project-slug"
PAKASIR_API_KEY="pakasir-api-key" # Keep secret!
PAKASIR_BASE_URL="https://app.pakasir.com"
# Public app URL for payment redirects, webhooks, canonical links, OG, sitemap, and email links.
SITE_URL="http://localhost:3000"
VITE_PUBLIC_SITE_URL="http://localhost:3000"
# Legacy fallback still supported by code that has not migrated yet.
VITE_SITE_URL="http://localhost:3000"

# RajaOngkir Shipping
RAJAONGKIR_API_KEY="rajaongkir-api-key" # Keep secret!
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1"

# Resend Email Integration
RESEND_API_KEY="re_yourkey"
RESEND_SENDER_EMAIL="Tokolink <noreply@yourdomain.com>"
