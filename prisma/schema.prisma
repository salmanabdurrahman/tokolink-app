generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  avatarUrl     String?   @map("avatar_url")
  provider      String    @default("email")       // "email" | "google"
  supabaseId    String    @unique @map("supabase_id")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant?

  @@map("users")
}

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_codes")
}

model AuthRateLimit {
  id        String   @id @default(uuid()) @db.Uuid
  event     String
  scopeKey  String   @map("scope_key")
  emailHash String   @default("") @map("email_hash")
  ipHash    String   @default("") @map("ip_hash")
  userHash  String   @default("") @map("user_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, scopeKey, createdAt])
  @@map("auth_rate_limits")
}

model AuthAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  event     String
  emailHash String   @default("") @map("email_hash")
  ipHash    String   @default("") @map("ip_hash")
  userHash  String   @default("") @map("user_hash")
  outcome   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@map("auth_audit_logs")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  tagline   String   @default("")
  avatar    String   @default("")
  whatsapp  String   @default("")
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  links     Link[]
  media     Media[]

  @@index([slug])
  @@map("tenants")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   @default("")
  basePrice   Int      @map("base_price")
  image       String   @default("")
  sortOrder   Int      @default(0) @map("sort_order")
  tenantId    String   @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantGroups ProductVariantGroup[]
  media         Media[]

  @@index([tenantId])
  @@map("products")
}

model Media {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  url       String
  size      Int
  mime      String
  ownerType String   @map("owner_type")
  ownerId   String   @map("owner_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String?  @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([ownerType, ownerId])
  @@map("media")
}

model ProductVariantGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String                           // e.g. "Ukuran", "Warna"
  sortOrder Int      @default(0) @map("sort_order")
  productId String   @map("product_id") @db.Uuid

  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   ProductVariantOption[]

  @@index([productId])
  @@map("product_variant_groups")
}

model ProductVariantOption {
  id         String @id @default(uuid()) @db.Uuid
  name       String
  priceDelta Int    @default(0) @map("price_delta")
  sortOrder  Int    @default(0) @map("sort_order")
  groupId    String @map("group_id") @db.Uuid

  group ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_variant_options")
}

model Link {
  id        String   @id @default(uuid()) @db.Uuid
  label     String
  url       String
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("links")
}